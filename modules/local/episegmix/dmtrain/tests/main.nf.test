// nf-core modules test episegmix/dmtrain
nextflow_process {

    name "Test Process EPISEGMIX_DMTRAIN"
    script "../main.nf"
    process "EPISEGMIX_DMTRAIN"

    tag "modules"
    tag "modules_episegmix"
    tag "episegmix"
    tag "episegmix/dmtrain"

    test("Kidney - EPISEGMIX_DMTRAIN") {

        when {
            process {
                """
                input[0] = [
                    'kidney_P0_2', 
                    [
                        [
                            id: 'kidney_P0', 
                            replicate: 1, 
                            epigenetic_mark: 'H3K4me3', 
                            modality: 'ChIP-seq', 
                            paired_end: false, 
                            distribution: 'NBI'
                        ]
                    ], 
                    file(params.pipelines_testdata_base_path + '/modules/kidney_P0.tab', checkIfExists: true), 
                    [ id: 'no_bed_counts' ], 
                    [], 
                    2, 
                    file(params.pipelines_testdata_base_path + '/modules/kidney_P0_2.yaml', checkIfExists: true), 
                    file(params.pipelines_testdata_base_path + '/modules/ldm/kidney_P0_2-train-counts.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/modules/ldm/kidney_P0_2-train-regions.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/modules/ldm/kidney_P0_2-train-counts-meth.txt', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("Kidney - EPISEGMIX_DMTRAIN - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    'kidney_P0_2', 
                    [
                        [
                            id: 'kidney_P0', 
                            replicate: 1, 
                            epigenetic_mark: 'H3K4me3', 
                            modality: 'ChIP-seq', 
                            paired_end: false, 
                            distribution: 'NBI'
                        ]
                    ], 
                    file(params.pipelines_testdata_base_path + '/modules/kidney_P0.tab', checkIfExists: true), 
                    [ id: 'no_bed_counts' ], 
                    [], 
                    2, 
                    file(params.pipelines_testdata_base_path + '/modules/kidney_P0_2.yaml', checkIfExists: true), 
                    file(params.pipelines_testdata_base_path + '/modules/ldm/kidney_P0_2-train-counts.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/modules/ldm/kidney_P0_2-train-regions.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/modules/ldm/kidney_P0_2-train-counts-meth.txt', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}