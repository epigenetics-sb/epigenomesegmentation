// nf-core modules test episegmix/bestdistribution
nextflow_process {

    name "Test Process EPISEGMIX_BESTDISTRIBUTION"
    script "../main.nf"
    process "EPISEGMIX_BESTDISTRIBUTION"

    tag "modules"
    tag "modules_episegmix"
    tag "episegmix"
    tag "episegmix/bestdistribution"

    test("Kidney - EPISEGMIX_BESTDISTRIBUTION") {

        when {
            process {
                """
                input[0] = [
                    file(params.pipelines_testdata_base_path + '/modules/fitting/kidney_P0_NBI_2_H3K4me3.log', checkIfExists: true), 
                    file(params.pipelines_testdata_base_path + '/modules/fitting/kidney_P0_SI_2_H3K4me3.log', checkIfExists: true), 
                    file(params.pipelines_testdata_base_path + '/modules/fitting/kidney_P0_BNB_2_H3K4me3.log', checkIfExists: true)
                ]
                input[1] = file(params.pipelines_testdata_base_path + '/modules/fitting/samplesheet.csv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("Kidney - EPISEGMIX_BESTDISTRIBUTION - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    file(params.pipelines_testdata_base_path + '/modules/fitting/kidney_P0_NBI_2_H3K4me3.log', checkIfExists: true), 
                    file(params.pipelines_testdata_base_path + '/modules/fitting/kidney_P0_SI_2_H3K4me3.log', checkIfExists: true), 
                    file(params.pipelines_testdata_base_path + '/modules/fitting/kidney_P0_BNB_2_H3K4me3.log', checkIfExists: true)
                ]
                input[1] = file(params.pipelines_testdata_base_path + '/modules/fitting/samplesheet.csv', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}