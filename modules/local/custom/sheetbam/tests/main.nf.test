// nf-core modules test custom/sheetbam
nextflow_process {

    name "Test Process CUSTOM_SHEETBAM"
    script "../main.nf"
    process "CUSTOM_SHEETBAM"

    tag "modules"
    tag "modules_custom"
    tag "custom"
    tag "custom/sheetbam"

    test("Kidney - SHEETBAM") {

        when {
            process {
                """
                input[0] = [
                    'kidney_P0',
                    [
                        [
                            id: 'kidney_P0',
                            replicate: 1,
                            epigenetic_mark: 'H3K4me3',
                            modality: 'ChIP-seq',
                            paired_end: false,
                            distribution: 'NBI'
                        ]
                    ],
                    [
                        file(params.pipelines_testdata_base_path + '/modules/H3K4me3_mm10_kidney_chr12_reduced.nochr.bam', checkIfExists: true)
                    ],
                    [
                        file(params.pipelines_testdata_base_path + '/modules/H3K4me3_mm10_kidney_chr12_reduced.nochr.bam.bai', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("Kidney - SHEETBAM - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    'kidney_P0',
                    [
                        [
                            id: 'kidney_P0',
                            replicate: 1,
                            epigenetic_mark: 'H3K4me3',
                            modality: 'ChIP-seq',
                            paired_end: false,
                            distribution: 'NBI'
                        ]
                    ],
                    [
                        file(params.pipelines_testdata_base_path + '/modules/H3K4me3_mm10_kidney_chr12_reduced.nochr.bam', checkIfExists: true)
                    ],
                    [
                        file(params.pipelines_testdata_base_path + '/modules/H3K4me3_mm10_kidney_chr12_reduced.nochr.bam.bai', checkIfExists: true)
                    ]
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
