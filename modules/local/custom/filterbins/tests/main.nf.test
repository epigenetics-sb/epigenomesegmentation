// nf-core modules test custom/filterbins
nextflow_process {

    name "Test Process CUSTOM_FILTERBINS"
    script "../main.nf"
    process "CUSTOM_FILTERBINS"

    tag "modules"
    tag "modules_custom"
    tag "custom"
    tag "custom/filterbins"

    test("mm10 - FILTERBINS") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'mm10' ], 
                    file(params.pipelines_testdata_base_path + '/modules/mm10_10000bp.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("mm10 - FILTERBINS - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'mm10' ], 
                    file(params.pipelines_testdata_base_path + '/modules/mm10_10000bp.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}