// nf-core modules test custom/bamcounts
nextflow_process {

    name "Test Process CUSTOM_BAMCOUNTS"
    script "../main.nf"
    process "CUSTOM_BAMCOUNTS"

    tag "modules"
    tag "modules_"
    tag "custom"
    tag "custom/bamcounts"

    test("Kidney - BAMCOUNTS") {

        // (the module requires running more than one process to generate the required output)
        // add the 'setup' method here.
        // You can find more information about how to use a 'setup' method in the nf-test docs (https://www.nf-test.com/docs/testcases/setup/).

    when {
        process {
                """
                input[0] = [
                    'kidney_P0', 
                    [ 
                        id: 'kidney_P0', 
                        replicate: 1, 
                        epigenetic_mark: 'H3K4me3', 
                        modality: 'ChIP-seq', 
                        paired_end: false, 
                        distribution: 'NBI' 
                    ],
                    file(params.pipelines_testdata_base_path + '/modules/kidney_P0.txt', checkIfExists: true),
                    file(params.pipelines_testdata_base_path + '/modules/H3K4me3_mm10_kidney_chr12_reduced.nochr.bam', checkIfExists: true)
                ]
                
                input[1] = [ 
                    'mm10', 
                    file(params.pipelines_testdata_base_path + '/modules/filtered_mm10.chrom.sizes.v2', checkIfExists: true) 
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
                // See https://nf-co.re/docs/developing/testing/assertions for more information and examples.
            )
        }

    }

    test("Kidney - BAMCOUNTS - stub") {

            options "-stub"

            when {
                process {
                    """
                    input[0] = [
                        'kidney_P0', 
                        [ 
                            id: 'kidney_P0', 
                            replicate: 1, 
                            epigenetic_mark: 'H3K4me3', 
                            modality: 'ChIP-seq', 
                            paired_end: false, 
                            distribution: 'NBI' 
                        ],
                        file(params.pipelines_testdata_base_path + '/modules/kidney_P0.txt', checkIfExists: true),
                        file(params.pipelines_testdata_base_path + '/modules/H3K4me3_mm10_kidney_chr12_reduced.nochr.bam', checkIfExists: true)
                    ]
                    
                    input[1] = [ 
                        'mm10', 
                        file(params.pipelines_testdata_base_path + '/modules/filtered_mm10.chrom.sizes.v2', checkIfExists: true) 
                    ]
                    """
                }
            }

            then {
                assert process.success
                assertAll(
                    { assert snapshot(process.out).match() }
                )
            }

        }

}