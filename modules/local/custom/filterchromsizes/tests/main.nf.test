// nf-core modules test custom/filterchromsizes
nextflow_process {

    name "Test Process CUSTOM_FILTERCHROMSIZES"
    script "../main.nf"
    process "CUSTOM_FILTERCHROMSIZES"

    tag "modules"
    tag "modules_custom"
    tag "custom"
    tag "custom/filterchromsizes"

    test("mm10 - FILTERCHROMSIZES") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/modules/mm10.chrom.sizes', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("mm10 - FILTERCHROMSIZES - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/modules/mm10.chrom.sizes', checkIfExists: true)
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}