// nf-core modules test custom/filterbed
nextflow_process {

    name "Test Process CUSTOM_FILTERBED"
    script "../main.nf"
    process "CUSTOM_FILTERBED"

    tag "modules"
    tag "modules_custom"
    tag "custom"
    tag "custom/filterbed"

    test("Kidney - FILTERBED") {

        when {
            process {
                """
                input[0] = [
                    [
                        id: 'kidney_P0',
                        replicate: 1,
                        epigenetic_mark: 'WGBS',
                        modality: 'WGBS',
                        paired_end: true,
                        distribution: 'BI'
                    ],
                    file(params.pipelines_testdata_base_path + '/modules/kidney_P0_binnedbedcounts_synced.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("Kidney - FILTERBED - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [
                        id: 'kidney_P0',
                        replicate: 1,
                        epigenetic_mark: 'WGBS',
                        modality: 'WGBS',
                        paired_end: true,
                        distribution: 'BI'
                    ],
                    file(params.pipelines_testdata_base_path + '/modules/kidney_P0_binnedbedcounts_synced.bed', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
