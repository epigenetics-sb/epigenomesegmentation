// nf-core modules test custom/stripheader
nextflow_process {

    name "Test Process CUSTOM_STRIPHEADER"
    script "../main.nf"
    process "CUSTOM_STRIPHEADER"

    tag "modules"
    tag "modules_custom"
    tag "custom"
    tag "custom/stripheader"

    test("Kidney - STRIPHEADER") {

        when {
            process {
                """
                input[0] = [
                    [ id: 'kidney_P0' ],
                    file(params.pipelines_testdata_base_path + '/modules/kidney_P0.tab', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("Kidney - STRIPHEADER - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id: 'kidney_P0' ],
                    file(params.pipelines_testdata_base_path + '/modules/kidney_P0.tab', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(process.out).match() }
            )
        }

    }

}
